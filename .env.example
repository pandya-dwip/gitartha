# Copy this file to `.env` and fill in the values for your environment.
# `.env` is git-ignored; never commit real credentials.

# Application
APP_NAME=Gitartha
APP_ENV=development

# Supabase
# Use the project URL and the PUBLISHABLE (anon) key only.
# Never put a secret / service-role key in this file: it ships inside the app.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Content publisher (tool/publish_gita_content.dart). Optional: if unset,
# the publisher falls back to SUPABASE_ANON_KEY above. Use the project's
# PUBLISHABLE key (sb_publishable_...); secret/service-role keys are refused.
# Publishing permission comes from your own login + app_members.is_accessible,
# never from a key. Your password is asked interactively; never put it here.
SUPABASE_PUBLISHABLE_KEY=
