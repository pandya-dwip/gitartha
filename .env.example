# Copy this file to `.env` and fill in the values for your environment.
# `.env` is git-ignored; never commit real credentials.

# Application
APP_NAME=Gitartha
APP_ENV=development

# Supabase — used by the app (sign-in, membership) and by the content
# publisher (tool/publish_gita_content.dart).
# Use the project URL and the PUBLISHABLE key (sb_publishable_...) only.
# Never put a secret / service-role key or a database password here: `.env`
# ships inside the app bundle. Both the app and the publisher refuse
# privileged keys. Permissions come from each user's own login and
# app_members.is_accessible, enforced by RLS, never from a key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Legacy name for the same publishable key. Used only if
# SUPABASE_PUBLISHABLE_KEY is empty. Leave it empty in new setups.
SUPABASE_ANON_KEY=
