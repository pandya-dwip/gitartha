<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: canvas colour only. Android would otherwise
         always draw the launcher icon here, followed by Flutter's own splash
         (logo + name) at a different size: the "two splash screens" effect. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/gitartha_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/gitartha_canvas</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/gitartha_canvas</item>
    </style>
</resources>
