  "fixed_sql": [
    {
      "name": "local_chapters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_chapters\" (\"id\" INTEGER NOT NULL CHECK(\"id\" BETWEEN 1 AND 18), \"sanskrit_name\" TEXT NOT NULL, \"hindi_name\" TEXT NOT NULL, \"english_name\" TEXT NOT NULL, \"introduction\" TEXT NULL, \"overview\" TEXT NULL, \"central_theme\" TEXT NULL, \"key_topics\" TEXT NULL, \"summary\" TEXT NULL, \"conclusion\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "local_shlokas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_shlokas\" (\"id\" TEXT NOT NULL CHECK(LENGTH(\"id\") = 36), \"chapter_id\" INTEGER NOT NULL REFERENCES local_chapters (id) ON DELETE RESTRICT, \"verse_number\" INTEGER NOT NULL CHECK(\"verse_number\" > 0), \"reference\" TEXT NOT NULL, \"index_title\" TEXT NULL, \"index_summary\" TEXT NULL, \"sanskrit_text\" TEXT NULL, \"transliteration\" TEXT NULL, \"hindi_meaning\" TEXT NULL, \"hindi_meaning_note\" TEXT NULL, \"english_meaning\" TEXT NULL, \"context\" TEXT NULL, \"life_lesson\" TEXT NULL, \"spiritual_meaning\" TEXT NULL, \"reflection_question\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"chapter_id\", \"verse_number\"), CHECK (reference = chapter_id || '.' || verse_number)) STRICT;"
        }
      ]
    },
    {
      "name": "reflections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reflections\" (\"id\" TEXT NOT NULL CHECK(LENGTH(\"id\") = 36), \"shloka_id\" TEXT NOT NULL REFERENCES local_shlokas (id) ON DELETE RESTRICT, \"answer\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(answer, ' ' || char(9) || char(10) || char(13))) > 0), CHECK (updated_at >= created_at)) STRICT;"
        }
      ]
    },
    {
      "name": "personal_notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"personal_notes\" (\"id\" TEXT NOT NULL CHECK(LENGTH(\"id\") = 36), \"shloka_id\" TEXT NULL REFERENCES local_shlokas (id) ON DELETE RESTRICT, \"title\" TEXT NULL, \"content\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(content, ' ' || char(9) || char(10) || char(13))) > 0), CHECK (title IS NULL OR length(trim(title, ' ' || char(9) || char(10) || char(13))) > 0), CHECK (updated_at >= created_at)) STRICT;"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"id\" TEXT NOT NULL CHECK(LENGTH(\"id\") = 36), \"shloka_id\" TEXT NOT NULL UNIQUE REFERENCES local_shlokas (id) ON DELETE RESTRICT, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "reading_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_progress\" (\"id\" TEXT NOT NULL CHECK(LENGTH(\"id\") = 36), \"shloka_id\" TEXT NOT NULL UNIQUE REFERENCES local_shlokas (id) ON DELETE RESTRICT, \"status\" TEXT NOT NULL, \"first_opened_at\" TEXT NOT NULL, \"last_opened_at\" TEXT NOT NULL, \"studied_at\" TEXT NULL, \"reflected_at\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (status IN ('opened', 'read', 'studied', 'reflected')), CHECK (last_opened_at >= first_opened_at)) STRICT;"
        }
      ]
    },
    {
      "name": "reading_history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_history\" (\"id\" TEXT NOT NULL CHECK(LENGTH(\"id\") = 36), \"shloka_id\" TEXT NOT NULL REFERENCES local_shlokas (id) ON DELETE RESTRICT, \"action\" TEXT NOT NULL, \"occurred_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (\"action\" IN ('opened', 'marked_read', 'marked_studied', 'marked_reflected'))) STRICT;"
        }
      ]
    },
    {
      "name": "local_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_settings\" (\"key\" TEXT NOT NULL CHECK(LENGTH(\"key\") > 0), \"value\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"key\")) STRICT;"
        }
      ]
    },
